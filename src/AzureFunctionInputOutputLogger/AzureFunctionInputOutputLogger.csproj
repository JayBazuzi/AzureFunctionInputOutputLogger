<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>AzureFunctionInputOutputLogger</PackageId>
    <Description>Logs the query parameters, request body and response body of HTTP-triggered Azure Functions running in the isolated worker model.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AzureFunctionInputOutputLogger.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
  </ItemGroup>
</Project>
